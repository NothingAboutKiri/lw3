digraph G {
rankdir=RL; nodesep=0.35; ranksep=0.55;
node [shape=plain, fontname="DejaVu Sans", fontsize=10]; edge [fontname="DejaVu Sans", fontsize=9];
"Serializable" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff"><tr><td><font point-size="10">«trait»</font></td></tr><tr><td bgcolor="#dbe8f7"><b><i>Serializable</i></b></td></tr><tr><td> </td></tr><tr><td align="left" balign="left"><i>save_binary(&amp;self, out: &amp;mut dyn Write)</i><br align="left"/><i>load_binary(&amp;mut self, input: &amp;mut dyn Read)</i><br align="left"/><i>save_text / load_text</i><br align="left"/>save / load (format) {default}<br align="left"/>save_file / load_file {default}<br align="left"/></td></tr></table>>];
"Container" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff"><tr><td><font point-size="10">«trait»</font></td></tr><tr><td bgcolor="#dbe8f7"><b><i>Container</i></b></td></tr><tr><td> </td></tr><tr><td align="left" balign="left"><i>length(&amp;self) -&gt; usize</i><br align="left"/>is_empty(&amp;self) -&gt; bool {default}<br align="left"/><i>clear(&amp;mut self)</i><br align="left"/><i>type_name(&amp;self) -&gt; &amp;str</i><br align="left"/></td></tr></table>>];
"Sequence" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff"><tr><td><font point-size="10">«trait»</font></td></tr><tr><td bgcolor="#dbe8f7"><b><i>Sequence</i></b></td></tr><tr><td> </td></tr><tr><td align="left" balign="left"><i>values(&amp;self) -&gt; Vec&lt;String&gt;</i><br align="left"/><i>restore(&amp;mut self, value: &amp;str)</i><br align="left"/></td></tr></table>>];
"HashTable" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff"><tr><td><font point-size="10">«trait»</font></td></tr><tr><td bgcolor="#dbe8f7"><b><i>HashTable</i></b></td></tr><tr><td> </td></tr><tr><td align="left" balign="left"><i>put / get / remove</i><br align="left"/><i>for_each_pair</i><br align="left"/><i>capacity</i><br align="left"/>contains / load_factor / pairs {default}<br align="left"/></td></tr></table>>];
"Array" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff"><tr><td bgcolor="#dbe8f7"><b>Array</b></td></tr><tr><td align="left" balign="left">-data: Box&lt;[String]&gt;<br align="left"/>-size: usize<br align="left"/></td></tr><tr><td align="left" balign="left">+push_back / insert / get / set / erase<br align="left"/>+length / as_slice<br align="left"/></td></tr></table>>];
"SinglyList" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff"><tr><td bgcolor="#dbe8f7"><b>SinglyList</b></td></tr><tr><td align="left" balign="left">-nodes: Vec&lt;Option&lt;Node&gt;&gt;<br align="left"/>-free: Vec&lt;usize&gt;<br align="left"/>-head, tail: Option&lt;usize&gt;<br align="left"/></td></tr><tr><td align="left" balign="left">+push_front / push_back / pop_*<br align="left"/>+insert_after / insert_before / remove<br align="left"/>+get / contains / front / values<br align="left"/></td></tr></table>>];
"DoublyList" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff"><tr><td bgcolor="#dbe8f7"><b>DoublyList</b></td></tr><tr><td align="left" balign="left">-nodes: Vec&lt;Option&lt;Node&gt;&gt;<br align="left"/>-free: Vec&lt;usize&gt;<br align="left"/>-head, tail: Option&lt;usize&gt;<br align="left"/></td></tr><tr><td align="left" balign="left">+push_* / pop_* / insert_*<br align="left"/>+remove / get / contains / values<br align="left"/></td></tr></table>>];
"Stack" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff"><tr><td bgcolor="#dbe8f7"><b>Stack</b></td></tr><tr><td align="left" balign="left">-list: SinglyList<br align="left"/></td></tr><tr><td align="left" balign="left">+push / pop / top / values<br align="left"/></td></tr></table>>];
"Queue" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff"><tr><td bgcolor="#dbe8f7"><b>Queue</b></td></tr><tr><td align="left" balign="left">-list: SinglyList<br align="left"/></td></tr><tr><td align="left" balign="left">+push / pop / front / values<br align="left"/></td></tr></table>>];
"RBTree" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff"><tr><td bgcolor="#dbe8f7"><b>RBTree</b></td></tr><tr><td align="left" balign="left">-nodes: Vec&lt;Node&gt;<br align="left"/>-root: usize (0 = NIL)<br align="left"/></td></tr><tr><td align="left" balign="left">+insert / erase / contains<br align="left"/>+keys / preorder / bfs / is_valid<br align="left"/></td></tr></table>>];
"ChainHashTable" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff"><tr><td bgcolor="#dbe8f7"><b>ChainHashTable</b></td></tr><tr><td align="left" balign="left">-buckets: Vec&lt;Option&lt;Box&lt;Entry&gt;&gt;&gt;<br align="left"/></td></tr><tr><td align="left" balign="left">+longest_chain()<br align="left"/></td></tr></table>>];
"OpenHashTable" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff"><tr><td bgcolor="#dbe8f7"><b>OpenHashTable</b></td></tr><tr><td align="left" balign="left">-probing: Probing<br align="left"/>-keys, values: Vec&lt;String&gt;<br align="left"/>-cells: Vec&lt;Cell&gt;<br align="left"/></td></tr><tr><td align="left" balign="left">+probes(key)<br align="left"/></td></tr></table>>];
Container -> Serializable [arrowhead=empty, arrowsize=1.1]
Sequence -> Container [arrowhead=empty, arrowsize=1.1]
HashTable -> Container [arrowhead=empty, arrowsize=1.1]
Array -> Sequence [arrowhead=empty, style=dashed, arrowsize=1.1]
SinglyList -> Sequence [arrowhead=empty, style=dashed, arrowsize=1.1]
DoublyList -> Sequence [arrowhead=empty, style=dashed, arrowsize=1.1]
Stack -> Sequence [arrowhead=empty, style=dashed, arrowsize=1.1]
Queue -> Sequence [arrowhead=empty, style=dashed, arrowsize=1.1]
RBTree -> Sequence [arrowhead=empty, style=dashed, arrowsize=1.1]
ChainHashTable -> HashTable [arrowhead=empty, style=dashed, arrowsize=1.1]
OpenHashTable -> HashTable [arrowhead=empty, style=dashed, arrowsize=1.1]
Stack -> SinglyList [arrowtail=diamond, dir=back, constraint=false, arrowsize=1.1, label="  1"]
Queue -> SinglyList [arrowtail=diamond, dir=back, constraint=false, arrowsize=1.1, label="  1"]
}