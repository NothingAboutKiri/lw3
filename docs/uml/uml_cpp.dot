digraph G {
rankdir=RL; nodesep=0.35; ranksep=0.55;
node [shape=plain, fontname="DejaVu Sans", fontsize=10]; edge [fontname="DejaVu Sans", fontsize=9];
"Serializable" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff"><tr><td><font point-size="10">«interface»</font></td></tr><tr><td bgcolor="#dbe8f7"><b><i>Serializable</i></b></td></tr><tr><td> </td></tr><tr><td align="left" balign="left"><i>+save_binary(out: ostream&amp;) : void</i><br align="left"/><i>+load_binary(in: istream&amp;) : void</i><br align="left"/><i>+save_text(out: ostream&amp;) : void</i><br align="left"/><i>+load_text(in: istream&amp;) : void</i><br align="left"/>+save(out, format: Format) : void<br align="left"/>+load(in, format: Format) : void<br align="left"/>+save_file(path, format) : void<br align="left"/>+load_file(path, format) : void<br align="left"/></td></tr></table>>];
"Container" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff"><tr><td bgcolor="#dbe8f7"><b><i>Container</i></b></td></tr><tr><td> </td></tr><tr><td align="left" balign="left"><i>+length() : int</i><br align="left"/>+empty() : bool<br align="left"/><i>+clear() : void</i><br align="left"/><i>+type_name() : string</i><br align="left"/></td></tr></table>>];
"Sequence" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff"><tr><td bgcolor="#dbe8f7"><b><i>Sequence</i></b></td></tr><tr><td> </td></tr><tr><td align="left" balign="left"><i>+values() : Array</i><br align="left"/>+save_binary(out) : void<br align="left"/>+load_binary(in) : void<br align="left"/>+save_text(out) : void<br align="left"/>+load_text(in) : void<br align="left"/><i>#restore(value: string) : void</i><br align="left"/></td></tr></table>>];
"HashTable" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff"><tr><td bgcolor="#dbe8f7"><b><i>HashTable</i></b></td></tr><tr><td> </td></tr><tr><td align="left" balign="left"><i>+put(key, value) : bool</i><br align="left"/><i>+get(key) : optional&lt;string&gt;</i><br align="left"/><i>+remove(key) : bool</i><br align="left"/>+contains(key) : bool<br align="left"/><i>+for_each_pair(visit) : void</i><br align="left"/><i>+capacity() : int</i><br align="left"/>+load_factor() : double<br align="left"/>+save_binary(out) : void<br align="left"/>+load_binary(in) : void<br align="left"/>+save_text(out) : void<br align="left"/>+load_text(in) : void<br align="left"/></td></tr></table>>];
"Array" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff"><tr><td bgcolor="#dbe8f7"><b>Array</b></td></tr><tr><td align="left" balign="left">-data : string*<br align="left"/>-size : int<br align="left"/>-capacity : int<br align="left"/></td></tr><tr><td align="left" balign="left">+push_back(value)<br align="left"/>+insert(index, value) : bool<br align="left"/>+get(index, value&amp;) : bool<br align="left"/>+set(index, value) : bool<br align="left"/>+erase(index, removed&amp;) : bool<br align="left"/>+at(index) : string<br align="left"/>-resize()<br align="left"/></td></tr></table>>];
"SinglyList" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff"><tr><td bgcolor="#dbe8f7"><b>SinglyList</b></td></tr><tr><td align="left" balign="left">-head : Node*<br align="left"/>-tail : Node*<br align="left"/>-count : int<br align="left"/></td></tr><tr><td align="left" balign="left">+push_front(v) / push_back(v)<br align="left"/>+insert_after(key, v) / insert_before(key, v) : bool<br align="left"/>+pop_front(out&amp;) / pop_back(out&amp;) : bool<br align="left"/>+remove(key) : bool<br align="left"/>+contains(key) : bool<br align="left"/>+get(i, out&amp;) / front(out&amp;) : bool<br align="left"/></td></tr></table>>];
"DoublyList" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff"><tr><td bgcolor="#dbe8f7"><b>DoublyList</b></td></tr><tr><td align="left" balign="left">-head : Node*<br align="left"/>-tail : Node*<br align="left"/>-count : int<br align="left"/></td></tr><tr><td align="left" balign="left">+push_front(v) / push_back(v)<br align="left"/>+insert_after / insert_before : bool<br align="left"/>+pop_front(out&amp;) / pop_back(out&amp;) : bool<br align="left"/>+remove(key) : bool<br align="left"/>+get(i, out&amp;) : bool<br align="left"/>-find(key) : Node*<br align="left"/>-unlink(node)<br align="left"/></td></tr></table>>];
"Stack" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff"><tr><td bgcolor="#dbe8f7"><b>Stack</b></td></tr><tr><td align="left" balign="left">-list : SinglyList<br align="left"/></td></tr><tr><td align="left" balign="left">+push(value)<br align="left"/>+pop(out&amp;) : bool<br align="left"/>+top(out&amp;) : bool<br align="left"/></td></tr></table>>];
"Queue" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff"><tr><td bgcolor="#dbe8f7"><b>Queue</b></td></tr><tr><td align="left" balign="left">-list : SinglyList<br align="left"/></td></tr><tr><td align="left" balign="left">+push(value)<br align="left"/>+pop(out&amp;) : bool<br align="left"/>+front(out&amp;) : bool<br align="left"/></td></tr></table>>];
"RBTree" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff"><tr><td bgcolor="#dbe8f7"><b>RBTree</b></td></tr><tr><td align="left" balign="left">-nil : Node*<br align="left"/>-root : Node*<br align="left"/>-count : int<br align="left"/></td></tr><tr><td align="left" balign="left">+insert(key) / erase(key) : bool<br align="left"/>+contains(key) : bool<br align="left"/>+min_key(out&amp;) / max_key(out&amp;) : bool<br align="left"/>+next(key, out&amp;) / prev(key, out&amp;) : bool<br align="left"/>+keys() / preorder() / inorder() / postorder() / bfs() : Array<br align="left"/>+diagram() : string<br align="left"/>+is_valid() : bool<br align="left"/>+save_/load_binary, save_/load_text<br align="left"/>-insert_fix(z) / erase_fix(x)<br align="left"/>-left_rotate(x) / right_rotate(x)<br align="left"/></td></tr></table>>];
"ChainHashTable" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff"><tr><td bgcolor="#dbe8f7"><b>ChainHashTable</b></td></tr><tr><td align="left" balign="left">-buckets_ : Entry**<br align="left"/>-bucket_count_ : int<br align="left"/>-count_ : int<br align="left"/></td></tr><tr><td align="left" balign="left">+put / get / remove<br align="left"/>+longest_chain() : int<br align="left"/>-index(key) : int<br align="left"/>-rehash(new_count)<br align="left"/></td></tr></table>>];
"OpenHashTable" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff"><tr><td bgcolor="#dbe8f7"><b>OpenHashTable</b></td></tr><tr><td align="left" balign="left">-probing_ : Probing<br align="left"/>-keys_, values_ : string*<br align="left"/>-cells_ : Cell*<br align="left"/>-count_, deleted_ : int<br align="left"/></td></tr><tr><td align="left" balign="left">+put / get / remove<br align="left"/>+probes(key) : int<br align="left"/>+is_prime(n) : bool {static}<br align="left"/>-probe(hash, i) : int<br align="left"/>-find(key, probes&amp;) : int<br align="left"/>-rebuild(new_size)<br align="left"/></td></tr></table>>];
Container -> Serializable [arrowhead=empty, arrowsize=1.1]
Sequence -> Container [arrowhead=empty, arrowsize=1.1]
HashTable -> Container [arrowhead=empty, arrowsize=1.1]
Array -> Sequence [arrowhead=empty, arrowsize=1.1]
